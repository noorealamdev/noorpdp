  "content": "<!-- wp:noorpdp/hero {\"backgroundImage\":{\"url\":\"http://localhost/noorblocks/wp-content/uploads/2026/07/hero-bg-image.jpg\",\"id\":124},\"textAlign\":\"left\",\"headingFontSize\":\"42px\",\"subheadingFontSize\":\"20px\",\"boxedWidth\":980,\"style\":{\"spacing\":{\"padding\":{\"top\":\"8.05rem\",\"bottom\":\"8.05rem\",\"left\":\"var:preset|spacing|30\",\"right\":\"var:preset|spacing|30\"}},\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-4\"}}}},\"textColor\":\"ast-global-color-4\"} -->\n<div class=\"wp-block-noorpdp-hero has-text-align-left has-ast-global-color-4-color has-text-color has-link-color\" style=\"padding-top:8.05rem;padding-right:var(--wp--preset--spacing--30);padding-bottom:8.05rem;padding-left:var(--wp--preset--spacing--30);background-image:url(http://localhost/noorblocks/wp-content/uploads/2026/07/hero-bg-image.jpg);background-size:cover;background-position:center\"><div class=\"noorpdp-hero__content is-boxed\" style=\"max-width:980px\"><h1 class=\"noorpdp-hero__heading\" style=\"font-size:42px\"><strong>Elevate Your Style With<br>Timeless Fashion</strong></h1><p class=\"noorpdp-hero__subheading\" style=\"font-size:20px\">Discover a curated collection of elegant fashion and premium jewelry designed to express your unique personality from everyday essentials to statement pieces.</p><div class=\"noorpdp-hero__actions\"><!-- wp:noorpdp/button {\"url\":\"#\",\"style\":{\"color\":{\"background\":\"#af8332\"}}} -->\n<div class=\"wp-block-noorpdp-button\"><a class=\"wp-block-noorpdp-button noorpdp-button__link has-background\" style=\"background-color:#af8332\" href=\"#\">Shop Now</a></div>\n<!-- /wp:noorpdp/button --></div></div></div>\n<!-- /wp:noorpdp/hero -->\n\n<!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\"><!-- wp:spacer {\"height\":\"31px\"} -->\n<div style=\"height:31px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:noorpdp/product-gallery-carousel /--></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:noorpdp/product-category /-->\n\n<!-- wp:noorpdp/product-title {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}},\"fontSize\":\"large\"} /-->\n\n<!-- wp:noorpdp/product-rating {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}}} /-->\n\n<!-- wp:noorpdp/product-price {\"style\":{\"typography\":{\"fontWeight\":\"700\"},\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}},\"fontSize\":\"large\"} /-->\n\n<!-- wp:noorpdp/product-short-description {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0.25rem\"}}}} /-->\n\n<!-- wp:noorpdp/product-add-to-cart {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\"}}}} /-->\n\n<!-- wp:noorpdp/icon-list {\"rows\":[{\"icon\":\"shipping\",\"text\":\"Free Shipping and Exchanges\"},{\"icon\":\"nt-shieldCheck\",\"text\":\"Flexible and Secure Payment, Pay on Delivery\"},{\"icon\":\"thumbsUp\",\"text\":\"600,000 Happy Customers\"}],\"style\":{\"typography\":{\"fontSize\":\"15px\"},\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}}} /-->\n\n<!-- wp:noorpdp/urgency {\"type\":\"countdown\",\"countdownSource\":\"custom\",\"customDate\":\"2026-07-28T21:08:32\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-4\"}}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|30\",\"bottom\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|30\",\"right\":\"var:preset|spacing|30\"}},\"border\":{\"radius\":{\"topLeft\":\"8px\",\"topRight\":\"8px\",\"bottomLeft\":\"8px\",\"bottomRight\":\"8px\"},\"color\":\"#2f2ad8\",\"width\":\"1px\"}},\"backgroundColor\":\"ast-global-color-0\",\"textColor\":\"ast-global-color-4\"} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"60px\"} -->\n<div style=\"height:60px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorpdp/product-tabs /-->\n\n<!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\"><!-- wp:spacer {\"height\":\"89px\"} -->\n<div style=\"height:89px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:media-text {\"mediaId\":216,\"mediaLink\":\"http://localhost/noorblocks/?attachment_id=216\",\"linkDestination\":\"none\",\"mediaType\":\"image\",\"mediaWidth\":54} -->\n<div class=\"wp-block-media-text is-stacked-on-mobile\" style=\"grid-template-columns:54% auto\"><figure class=\"wp-block-media-text__media\"><img src=\"http://localhost/noorblocks/wp-content/uploads/2026/07/testimonial-bg-image-1024x576.jpg\" alt=\"\" class=\"wp-image-216 size-full\"/></figure><div class=\"wp-block-media-text__content\"><!-- wp:paragraph {\"placeholder\":\"Content…\"} -->\n<p></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:noorpdp/heading -->\n<h2 class=\"wp-block-noorpdp-heading\"><strong>Our latest Women’s jewellery collection, crafted to reflect strength, style, and individuality.</strong></h2>\n<!-- /wp:noorpdp/heading --></div></div>\n<!-- /wp:media-text --></div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"59px\"} -->\n<div style=\"height:59px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorpdp/faq {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|ast-global-color-5\"}}},\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|80\",\"bottom\":\"var:preset|spacing|80\",\"left\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\"}}},\"backgroundColor\":\"ast-global-color-3\",\"textColor\":\"ast-global-color-5\",\"fontSize\":\"medium\"} -->\n<div class=\"wp-block-noorpdp-faq has-ast-global-color-5-color has-ast-global-color-3-background-color has-text-color has-background has-link-color has-medium-font-size\" style=\"padding-top:var(--wp--preset--spacing--80);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--80);padding-left:var(--wp--preset--spacing--40)\"><h2 class=\"noorpdp-faq__title\">Frequently Asked Questions</h2><div class=\"noorpdp-faq__accordion is-boxed\" style=\"max-width:800px\"><!-- wp:noorpdp/accordion -->\n<div data-wp-interactive=\"noorpdp/accordion\" data-wp-context=\"{&quot;open&quot;:{&quot;ids&quot;:[]},&quot;allowMultiple&quot;:false}\" class=\"wp-block-noorpdp-accordion is-boxed\" style=\"max-width:800px\"><!-- wp:noorpdp/accordion-item {\"uid\":\"faq-shipping\"} -->\n<div data-wp-context=\"{&quot;uid&quot;:&quot;faq-shipping&quot;}\" class=\"wp-block-noorpdp-accordion-item\"><h3 class=\"noorpdp-accordion__heading\"><button type=\"button\" class=\"noorpdp-accordion__toggle\" aria-controls=\"noorpdp-accordion-panel-faq-shipping\" aria-expanded=\"false\" data-wp-on--click=\"actions.toggle\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-class--is-open=\"state.isOpen\"><span class=\"noorpdp-accordion__title\">How long does shipping take?</span><span class=\"noorpdp-accordion__icon\" aria-hidden=\"true\"></span></button></h3><div id=\"noorpdp-accordion-panel-faq-shipping\" class=\"noorpdp-accordion__panel\" hidden data-wp-bind--hidden=\"!state.isOpen\"><!-- wp:paragraph -->\n<p>Most orders ship within 1-2 business days and arrive within 5-7 business days depending on your location.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:noorpdp/accordion-item -->\n\n<!-- wp:noorpdp/accordion-item {\"uid\":\"faq-returns\"} -->\n<div data-wp-context=\"{&quot;uid&quot;:&quot;faq-returns&quot;}\" class=\"wp-block-noorpdp-accordion-item\"><h3 class=\"noorpdp-accordion__heading\"><button type=\"button\" class=\"noorpdp-accordion__toggle\" aria-controls=\"noorpdp-accordion-panel-faq-returns\" aria-expanded=\"false\" data-wp-on--click=\"actions.toggle\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-class--is-open=\"state.isOpen\"><span class=\"noorpdp-accordion__title\">What is your return policy?</span><span class=\"noorpdp-accordion__icon\" aria-hidden=\"true\"></span></button></h3><div id=\"noorpdp-accordion-panel-faq-returns\" class=\"noorpdp-accordion__panel\" hidden data-wp-bind--hidden=\"!state.isOpen\"><!-- wp:paragraph -->\n<p>We offer a 30-day return window on unused items in their original packaging. Contact us to start a return.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:noorpdp/accordion-item -->\n\n<!-- wp:noorpdp/accordion-item {\"uid\":\"faq-international\"} -->\n<div data-wp-context=\"{&quot;uid&quot;:&quot;faq-international&quot;}\" class=\"wp-block-noorpdp-accordion-item\"><h3 class=\"noorpdp-accordion__heading\"><button type=\"button\" class=\"noorpdp-accordion__toggle\" aria-controls=\"noorpdp-accordion-panel-faq-international\" aria-expanded=\"false\" data-wp-on--click=\"actions.toggle\" data-wp-bind--aria-expanded=\"state.isOpen\" data-wp-class--is-open=\"state.isOpen\"><span class=\"noorpdp-accordion__title\">Do you ship internationally?</span><span class=\"noorpdp-accordion__icon\" aria-hidden=\"true\"></span></button></h3><div id=\"noorpdp-accordion-panel-faq-international\" class=\"noorpdp-accordion__panel\" hidden data-wp-bind--hidden=\"!state.isOpen\"><!-- wp:paragraph -->\n<p>Yes, we ship to most countries worldwide. International shipping rates are calculated at checkout.</p>\n<!-- /wp:paragraph --></div></div>\n<!-- /wp:noorpdp/accordion-item --></div>\n<!-- /wp:noorpdp/accordion --></div></div>\n<!-- /wp:noorpdp/faq -->\n\n<!-- wp:spacer {\"height\":\"94px\"} -->\n<div style=\"height:94px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:noorpdp/product-grid /-->\n\n<!-- wp:spacer {\"height\":\"94px\"} -->\n<div style=\"height:94px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->"
}